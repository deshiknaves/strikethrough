    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "clsx": "^2.1.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.3.6",
    "eslint-plugin-svelte": "^3.17.1",
    "eslint-plugin-tailwindcss": "4.0.0-beta.0",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
